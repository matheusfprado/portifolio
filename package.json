{
  "name": "tailwindui-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "check": "npm run lint && npm run build",
    "build:sync": "npm run build --workspace @portfolio/profile && npm run build --workspace @portfolio/profile-sync",
    "sync:profile": "npm run sync --workspace @portfolio/profile-sync"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
