    "@next/mdx": "^16.3.5",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/typography": "^0.5.4",
    "autoprefixer": "^10.4.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "fast-glob": "^3.2.11",
    "feed": "^4.2.2",
    "focus-visible": "^5.2.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.21.0",
    "next": "^16.3.5",
    "next-router-mock": "^0.9.3",
